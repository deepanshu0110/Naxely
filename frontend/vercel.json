{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*\\.(?:png|jpe?g|webp|svg|ico|pdf|mp4|woff2?|ttf|eot))",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://b.sf-syn.com https://c.sf-syn.com https://cdn-cookieyes.com https://www.clarity.ms https://scripts.clarity.ms https://static.cloudflareinsights.com https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src 'self' https://*.supabase.co https://b.sf-syn.com https://c.sf-syn.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://*.supabase.co https://api.naxely.com https://cdn-cookieyes.com https://log.cookieyes.com https://*.clarity.ms https://analytics.ahrefs.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()",
        "Content-Language": "en"
      },
      "continue": true
    },
    { "src": "/share/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "^/auth(?:/.*)?$", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "^/(dashboard|settings|report|scheduled-reports|templates)(?:/.*)?$", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "/pricing", "destination": "/pricing/index.html" },
    { "src": "/contact", "destination": "/contact/index.html" },
    { "src": "/terms", "destination": "/terms/index.html" },
    { "src": "/privacy", "destination": "/privacy/index.html" },
    { "src": "/cookie-policy", "destination": "/cookie-policy/index.html" },
    { "src": "/refund", "destination": "/refund/index.html" },
    { "src": "^/login$", "destination": "/shell.html" },
    { "src": "^/signup$", "destination": "/shell.html" },
    { "src": "^/auth(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/dashboard(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/report(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/scheduled-reports(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/settings(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/share(?:/.*)?$", "destination": "/shell.html" },
    { "src": "^/blog/client-reporting-for-freelance-consultants$", "destination": "/blog/best-client-reporting-software-freelancers", "status": 301 },
    { "src": "^/blog/client-reporting-tools-for-upwork-freelancer$", "destination": "/blog/best-client-reporting-software-freelancers", "status": 301 },
    { "src": "^/blog/client-reporting-tools-flat-pricing$", "destination": "/blog/best-client-reporting-software-freelancers", "status": 301 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/shell.html", "status": 404 }
  ]
}
